# Copy this file to .env (same folder as README.md) and fill what you need. .env is git-ignored.
APP_ENV=development
# Set true only for a controlled SIH demo that intentionally uses fictional public demo accounts.
ENABLE_DEMO_DATA=false
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters-long
# Required only when APP_ENV=production and the database has no users yet
BOOTSTRAP_ADMIN_USERNAME=portaladmin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-random-password-at-least-14-characters
# DB_PATH=/data/fdr.db          # persistent disk path when hosting
# UPLOAD_DIR=/data/uploads      # keep uploaded documents on the same persistent disk

# ---- Email (SMTP). Example for Gmail: enable 2-step verification, create an App Password ----
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=youraddress@gmail.com
# SMTP_PASS=your-16-char-app-password
# SMTP_FROM=youraddress@gmail.com

# ---- SMS (Twilio) ----
# TWILIO_SID=ACxxxxxxxxxxxxxxxx
# TWILIO_TOKEN=xxxxxxxx
# TWILIO_FROM=+1xxxxxxxxxx

# For production use a persistent database volume and set DB_PATH to its writable path.
# Never use demo credentials or the development secret in a public deployment.
